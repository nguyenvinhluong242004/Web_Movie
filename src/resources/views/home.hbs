<div class="list p-2">
    <h5 class="mb-3" style="color: rgb(255, 166, 0);">MỚI CẬP NHẬT</h5>

    <!-- Danh sách phim -->
    <div class="row">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-custom mb-4" v-for="(movie, index) in listMovies">
            <div class="card-comic">
                <div class="card-comic-img">
                    <a :href="DOMAIN+'detail-movie?id='+movie.slug">
                        <img :src="domain_image+'/'+image_movies[index]"
                            alt="">
                    </a>
                    <div class="info-comic">
                        <div class="text-center">
                            <div class="d-flex pl-1" style="font-size: 15px;">
                                [[ movie.name ]]
                            </div>
                            <div class="d-flex pl-1 pb-1" style="color: rgb(197, 197, 197); font-size: 13px;">
                                [[ movie.origin_name ]]
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        
    </div>




    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item" :class="{ disabled: page <= 1 }">
                <a class="page-link" :href="DOMAIN + '?page=' + (Number(page) - 1)">«</a>
            </li>

            <li class="page-item" v-for="pg in visiblePages" :key="pg" :class="{ active: pg === page }">
                <a class="page-link" :href="DOMAIN + '?page=' + pg">[[ pg ]]</a>
            </li>

            <li class="page-item" :class="{ disabled: page >= total_page }">
                <a class="page-link" :href="DOMAIN + '?page=' + (Number(page) + 1)">»</a>
            </li>
        </ul>
    </nav>

</div>
